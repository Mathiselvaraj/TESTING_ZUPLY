<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Zuply API Suite (parallel)" parallel="classes" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.cts.mfrp.Zuply.Utils.ExtentReportListener"/>
    </listeners>

    <test name="All API Modules">
        <classes>
            <class name="com.cts.mfrp.Zuply.tests.AuthTests"/>
            <class name="com.cts.mfrp.Zuply.tests.UserTests"/>
            <class name="com.cts.mfrp.Zuply.tests.ProductTests"/>
            <class name="com.cts.mfrp.Zuply.tests.UploadTests"/>
            <class name="com.cts.mfrp.Zuply.tests.ListingTests"/>
            <class name="com.cts.mfrp.Zuply.tests.CartTests"/>
            <class name="com.cts.mfrp.Zuply.tests.OrderTests"/>
            <class name="com.cts.mfrp.Zuply.tests.PaymentTests"/>
            <class name="com.cts.mfrp.Zuply.tests.SellerTests"/>
            <class name="com.cts.mfrp.Zuply.tests.AdminTests"/>
        </classes>
    </test>

</suite>
