<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Demo Suite — hand-picked UI test cases that cover all major user roles
  (Guest / Customer / Seller / Admin) and key features of the Zuply platform.

  Run with:
    mvn test -DsuiteXmlFile=src/test/resources/suites/demo-testng.xml

  Toggle visible browser:
    -Dheadless=false  (default — shows the browser)
    -Dheadless=true   (background, faster for CI)
-->
<suite name="Zuply Demo Suite" verbose="1" thread-count="1">

    <listeners>
        <listener class-name="com.cts.mfrp.zuply.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="headless" value="false"/>
    <parameter name="report.subdir" value="demo"/>

    <!-- ═══════════════════════════════════════════════════════════
         1. AUTHENTICATION  (Guest → Register / Login)
         TC001  Valid registration (customer + seller)
         TC003  Valid login
         AD_TC011  Password strength indicator
         AD_TC012  Login role chooser shows all three roles
    ═══════════════════════════════════════════════════════════ -->
    <test name="1 - Authentication">
        <groups>
            <run>
                <include name="auth"/>
            </run>
        </groups>
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.auth.AuthUiTests">
                <methods>
                    <include name="validRegistration"/>
                    <include name="validLogin"/>
                    <include name="tc011_passwordStrengthIndicator"/>
                    <include name="tc012_loginRoleChooserAllThreeRoles"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════
         2. HOME PAGE  (Guest view)
         TC006  Home page elements present
         AD_TC_HP1  Category section visible
         AD_TC_HP2  Top-bar components present
    ═══════════════════════════════════════════════════════════ -->
    <test name="2 - Home Page">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.buyer.HomePageUiTests"/>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════
         3. PRODUCT SEARCH  (Guest / Buyer)
         AD_TC_PS1  Anonymous user can browse products
    ═══════════════════════════════════════════════════════════ -->
    <test name="3 - Product Search">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.buyer.ProductSearchUiTests">
                <methods>
                    <include name="ps1_anonymousCanBrowseProducts"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════
         4. CART  (Buyer)
         TC013  Add to cart
         AD_TC_CART3  Remove item from cart
    ═══════════════════════════════════════════════════════════ -->
    <test name="4 - Shopping Cart">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.buyer.CartUiTests">
                <methods>
                    <include name="tc013_addToCart"/>
                    <include name="tcCart3_removeItemFromCart"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════
         5. SELLER DASHBOARD
         TC022  Seller dashboard loads
         TC023  Seller dashboard nav links present
         TC024  Seller orders page loads
    ═══════════════════════════════════════════════════════════ -->
    <test name="5 - Seller Dashboard">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.seller.SellerProductUiTests">
                <methods>
                    <include name="tc022_sellerDashboardLoads"/>
                    <include name="tc023_sellerDashboardNavLinks"/>
                    <include name="tc024_sellerOrdersPageLoads"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════
         6. ADMIN DASHBOARD
         TC050  Admin dashboard loads
         TC062  Admin sellers list view
    ═══════════════════════════════════════════════════════════ -->
    <test name="6 - Admin Dashboard">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.admin.AdminDashboardUiTests">
                <methods>
                    <include name="tc050_adminDashboardLoads"/>
                    <include name="tc062_sellersViewAllNavigates"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ═══════════════════════════════════════════════════════════
         7. SECURITY  (Role-based access control)
         TC039  Unauthorized users cannot access protected routes
    ═══════════════════════════════════════════════════════════ -->
    <test name="7 - Security / Role-Based Access">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.admin.SecurityUiTests"/>
        </classes>
    </test>

</suite>
