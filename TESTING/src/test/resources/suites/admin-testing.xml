<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Zuply Admin UI Suite" verbose="1">

    <listeners>
        <listener class-name="com.cts.mfrp.zuply.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="headless" value="false"/>

    <test name="Admin Product UI (TC022-TC023)">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.admin.AdminProductUiTests"/>
        </classes>
    </test>

    <test name="Admin Seller UI (TC024)">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.admin.AdminSellerUiTests"/>
        </classes>
    </test>

    <test name="Security UI (TC039)">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.admin.SecurityUiTests"/>
        </classes>
    </test>

    <test name="Admin Dashboard UI (TC050-TC069)">
        <classes>
            <class name="com.cts.mfrp.zuply.tests.ui.admin.AdminDashboardUiTests"/>
        </classes>
    </test>

</suite>